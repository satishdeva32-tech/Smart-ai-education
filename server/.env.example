# Copy this file to `.env` and fill in the values. DO NOT commit real secrets.

# Server
PORT=5000
NODE_ENV=development

# MongoDB - example formats:
# MONGODB_URI=mongodb+srv://<db_user>:<db_pass>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# JWT secret used for signing tokens
JWT_SECRET=

# Google Gemini / Generative AI API key (or GEMINI_API_KEY)
# Provide either GEMINI_API_KEY or GOOGLE_API_KEY depending on provider
GEMINI_API_KEY=
GOOGLE_API_KEY=

# If running the client separately, set CLIENT_URL to allow CORS
CLIENT_URL=http://localhost:5173
PORT=5000
MONGODB_URI=mongodb://localhost:27017/edugenie
JWT_SECRET=your_jwt_secret_here
NODE_ENV=development
GEMINI_API_KEY=your_gemini_api_key_here
